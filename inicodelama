@app.route('/api/scan-barcode', methods=['POST'])
@login_required
def scan_barcode():
    data = request.get_json()
    barcode = data.get('barcode')
    weight_detected = data.get('weight', 0)
    
    user_id = session['user_id']
    user = User.query.get(user_id)
    
    # Find product
    product = Product.query.filter_by(barcode=barcode).first()
    if not product:
        send_to_lcd("Scan Failed", "Product not found")
        return jsonify({'success': False, 'message': 'Produk tidak ditemukan!'})
    
    # Get active cart
    active_cart = Cart.query.filter_by(user_id=user_id, status='active').first()
    if not active_cart:
        active_cart = Cart(
            user_id=user_id,
            session_id=f"cart_{user_id}_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}"
        )
        db.session.add(active_cart)
        db.session.commit()
    
    # Check if item already in cart
    existing_item = CartItem.query.filter_by(
        cart_id=active_cart.id,
        product_id=product.id
    ).first()
    
    if existing_item:
        existing_item.quantity += 1
        existing_item.weight_detected = weight_detected
    else:
        new_item = CartItem(
            cart_id=active_cart.id,
            product_id=product.id,
            weight_detected=weight_detected
        )
        db.session.add(new_item)
    
    # Validate weight
    weight_tolerance = product.weight * 0.05
    is_valid_weight = abs(weight_detected - product.weight) <= weight_tolerance
    
    if existing_item:
        existing_item.is_validated = is_valid_weight
    else:
        new_item.is_validated = is_valid_weight
    
    db.session.commit()
    
    # Send to LCD
    send_to_lcd(f"Added: {product.name[:10]}", f"Rp{int(product.price)}")
    
    return jsonify({
        'success': True,
        'product': {
            'name': product.name,
            'price': product.price,
            'expected_weight': product.weight,
            'detected_weight': weight_detected,
            'is_valid': is_valid_weight
        }
    })

@app.route('/api/checkout', methods=['POST'])
@login_required
def checkout_api():
    data = request.get_json()
    payment_method = data.get('payment_method', 'cash')
    
    user_id = session['user_id']
    user = User.query.get(user_id)
    
    # Get active cart
    active_cart = Cart.query.filter_by(user_id=user_id, status='active').first()
    if not active_cart:
        send_to_lcd("Checkout Failed", "Empty cart")
        return jsonify({'success': False, 'message': 'Keranjang kosong!'})
    
    cart_items = CartItem.query.filter_by(cart_id=active_cart.id).all()
    if not cart_items:
        send_to_lcd("Checkout Failed", "No items")
        return jsonify({'success': False, 'message': 'Keranjang kosong!'})
    
    # Calculate total
    total_amount = sum(item.product.price * item.quantity for item in cart_items)
    
    # Create transaction
    transaction = Transaction(
        user_id=user_id,
        cart_id=active_cart.id,
        total_amount=total_amount,
        payment_method=payment_method,
        status='completed'
    )
    
    # Update cart status
    active_cart.status = 'completed'
    active_cart.total_amount = total_amount
    
    db.session.add(transaction)
    db.session.commit()
    
    # Send to LCD
    send_to_lcd("Checkout OK", f"Total: Rp{int(total_amount)}")
    
    return jsonify({
        'success': True,
        'transaction_id': transaction.id,
        'total_amount': total_amount,
        'message': 'Checkout berhasil!'
    })

