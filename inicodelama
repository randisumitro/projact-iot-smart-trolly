@app.route('/dashboard')
@login_required
def dashboard():
    user = User.query.get(session['user_id'])
    send_to_lcd("User Dashboard", f"Hi {user.username}")
    
    # Get active cart
    active_cart = Cart.query.filter_by(
        user_id=user.id, 
        status='active'
    ).first()
    
    if not active_cart:
        active_cart = Cart(
            user_id=user.id,
            session_id=f"cart_{user.id}_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}"
        )
        db.session.add(active_cart)
        db.session.commit()
    
    cart_items = db.session.query(CartItem).filter_by(cart_id=active_cart.id).all()
    total_amount = sum(item.product.price * item.quantity for item in cart_items)
    active_cart.total_amount = total_amount
    db.session.commit()
    
    return render_template('dashboard.html', 
                         user=user, 
                         cart=active_cart, 
                         cart_items=cart_items)

